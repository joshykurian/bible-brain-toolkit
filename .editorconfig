root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{html,json,yml,yaml,md}]
indent_size = 2

# the player code and styles use tabs
[shared/*.{js,css}]
indent_style = tab

[*.xml]
indent_style = tab

# WordPress and Joomla code follow their own tab-based standards
[packages/{wordpress,joomla}/**.php]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf
